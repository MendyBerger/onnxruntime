import onnx
from onnx import numpy_helper, TensorProto
import numpy as np
import copy

model = onnx.load('decoder_Q.onnx')

# SAVE original inputs/outputs BEFORE any modifications
original_inputs = [copy.deepcopy(i) for i in model.graph.input]
original_outputs = [copy.deepcopy(o) for o in model.graph.output]

# 1. Convert ALL initializers
for init in model.graph.initializer:
    if init.data_type == TensorProto.FLOAT16:
        arr = numpy_helper.to_array(init).astype(np.float32)
        new_tensor = numpy_helper.from_array(arr, init.name)
        init.CopyFrom(new_tensor)

# 2. Convert ALL value_info (intermediate tensors)
for vi in model.graph.value_info:
    if vi.type.HasField('tensor_type') and vi.type.tensor_type.elem_type == TensorProto.FLOAT16:
        vi.type.tensor_type.elem_type = TensorProto.FLOAT

# 3. Convert inputs/outputs types (keep shapes!)
for vi in list(model.graph.input) + list(model.graph.output):
    if vi.type.HasField('tensor_type') and vi.type.tensor_type.elem_type == TensorProto.FLOAT16:
        vi.type.tensor_type.elem_type = TensorProto.FLOAT

# 4. Convert node attributes
for node in model.graph.node:
    for attr in node.attribute:
        if attr.type == onnx.AttributeProto.TENSOR and attr.t.data_type == TensorProto.FLOAT16:
            arr = numpy_helper.to_array(attr.t).astype(np.float32)
            new_tensor = numpy_helper.from_array(arr, attr.t.name if attr.t.name else '')
            attr.t.CopyFrom(new_tensor)
        if attr.name == 'to' and attr.i == TensorProto.FLOAT16:
            attr.i = TensorProto.FLOAT

# 5. RESTORE original input/output structure (just update the type)
del model.graph.input[:]
for inp in original_inputs:
    if inp.type.HasField('tensor_type') and inp.type.tensor_type.elem_type == TensorProto.FLOAT16:
        inp.type.tensor_type.elem_type = TensorProto.FLOAT
    model.graph.input.append(inp)

del model.graph.output[:]
for out in original_outputs:
    if out.type.HasField('tensor_type') and out.type.tensor_type.elem_type == TensorProto.FLOAT16:
        out.type.tensor_type.elem_type = TensorProto.FLOAT
    model.graph.output.append(out)

# SKIP shape_inference - it corrupts the model!

onnx.save(model, 'decoder_Q_f32.onnx')
print('Done: decoder_Q_f32.onnx')

# Verify
m = onnx.load('decoder_Q_f32.onnx')
for i in m.graph.input:
    dims = [d.dim_value or d.dim_param for d in i.type.tensor_type.shape.dim]
    print(f'  Input: {i.name}, shape={dims}')
"



